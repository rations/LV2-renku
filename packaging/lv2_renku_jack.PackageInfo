name			lv2_renku_jack
version			@VERSION@-@REVISION@
architecture	x86_64
summary			"Headless JACK LV2 host (RenkuOS)"
description		"lv2jackhost: runs one LV2 plug-in as a JACK client, with a parameter
REPL. Handy for trying LV2 plug-ins against JACK without a DAW. Needs the jack package;
the LV2 specification bundles come from lv2_renku."
packager		"rations <ehqcar@proton.me>"
vendor			"rations"
copyrights {
	"2011-2026 David Robillard"
	"2026 rations"
}
licenses {
	"ISC"
}
provides {
	lv2_renku_jack = @VERSION@
	cmd:lv2jackhost = @VERSION@
}
requires {
	haiku >= @HAIKU_MIN@
	jack
	lv2_renku
}
urls {
	"https://github.com/rations/LV2-renku"
}
